# --- vLLM ---
VLLM_TAG=latest
MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
SERVED_NAME=qwen2.5-7b
MAX_MODEL_LEN=8192
GPU_UTIL=0.80
# Any long random string. The Pi's LiteLLM uses it to call vLLM (must match k8s/lab.env).
VLLM_API_KEY=change-me-vllm-key
# Only needed for gated models (Llama etc.). Qwen works without it.
HF_TOKEN=
