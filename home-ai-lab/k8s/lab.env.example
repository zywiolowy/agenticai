# Copy to lab.env and edit. install.sh reads this file.

# Fixed LAN IPs (set a DHCP reservation in your router)
PC_IP=192.168.1.10
PI_IP=192.168.1.20

# Must match VLLM_API_KEY in pc/.env
VLLM_API_KEY=change-me-vllm-key

# LiteLLM gateway (master key must start with "sk-")
LITELLM_MASTER_KEY=sk-change-me-master
LITELLM_DB_PASSWORD=change-me-db

# Langfuse project keys: http://PC_IP:3000 -> project -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Optional cloud fallback models
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

GRAFANA_PASSWORD=change-me-grafana
WEBUI_SECRET_KEY=change-me-webui
