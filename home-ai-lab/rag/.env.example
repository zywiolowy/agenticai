PI_IP=192.168.1.20
# Gateway and Qdrant are exposed by Traefik on the Pi (port 80) via nip.io hostnames
GATEWAY_URL=http://litellm.192.168.1.20.nip.io/v1
QDRANT_URL=http://qdrant.192.168.1.20.nip.io:80
# A LiteLLM virtual key (create one in http://litellm.<PI_IP>.nip.io/ui) or the master key for a first test
LITELLM_KEY=sk-change-me-master
COLLECTION=docs
CHAT_MODEL=local-chat
EMBED_MODEL=embed
TOP_K=5

# Langfuse SDK (same project keys as in k8s/lab.env); Langfuse runs on the Windows PC
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://192.168.1.10:3000
LANGFUSE_BASE_URL=http://192.168.1.10:3000
